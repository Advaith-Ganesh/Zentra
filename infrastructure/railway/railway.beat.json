{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/api.Dockerfile"
  },
  "deploy": {
    "startCommand": "celery -A zentra.workers.celery_app:celery_app beat --loglevel=INFO --schedule=/app/state/celerybeat-schedule",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
