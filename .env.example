# =============================================================================
# ZENTRA — environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# Never enable in production.
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json  (use json in production)

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Comma-separated list of browser origins permitted to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL — Supabase in production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/zentra
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/zentra_test

# -----------------------------------------------------------------------------
# Redis (Celery broker + rate limiting + idempotency)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# supabase -> verify Supabase Auth JWTs (production)
# local    -> self-hosted email/password auth against our own users table
#             (real Argon2 hashing + signed JWTs; for local dev/CI only)
AUTH_PROVIDER=local
# REQUIRED in every environment. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=zentra
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600

# -----------------------------------------------------------------------------
# Supabase (required when AUTH_PROVIDER=supabase)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# HS256 secret used by Supabase to sign user JWTs (Project Settings -> API).
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Scanning providers
# -----------------------------------------------------------------------------
# true  -> deterministic local mock providers, no external calls, no keys needed
# false -> real providers (requires the keys below; missing keys degrade to
#          "unavailable" results rather than failing the scan)
USE_MOCK_SCANNERS=true
SCANNER_HTTP_TIMEOUT_SECONDS=15
SCANNER_TOTAL_TIMEOUT_SECONDS=180
# SSL Labs public API needs no key but is heavily rate limited.
SSLLABS_API_URL=https://api.ssllabs.com/api/v3
SSLLABS_MAX_POLL_SECONDS=180
HIBP_API_KEY=
HIBP_API_URL=https://haveibeenpwned.com/api/v3
SHODAN_API_KEY=
SHODAN_API_URL=https://api.shodan.io
# NIST NVD. Optional key raises the rate limit.
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
STRIPE_REPORT_PACK_PRICE_ID=

# -----------------------------------------------------------------------------
# Email (Resend-compatible)
# -----------------------------------------------------------------------------
# resend | console  (console logs emails locally instead of sending)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Zentra <alerts@zentra.example>"

# -----------------------------------------------------------------------------
# Slack integration (feature flagged; disabled when credentials are absent)
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Encryption for integration secrets at rest (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
SECRETS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Rate limits (requests / window seconds)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
PUBLIC_SCAN_RATE_LIMIT=3/3600
AUTH_RATE_LIMIT=10/900
API_RATE_LIMIT=300/60
MANUAL_SCAN_RATE_LIMIT=20/3600
REPORT_RATE_LIMIT=10/3600

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_BENCHMARKING=true
FEATURE_SLACK=false
FEATURE_TEAMS=true
FEATURE_MSSP=false
FEATURE_WHITE_LABEL=true
FEATURE_PUBLIC_API=true
FEATURE_ADVANCED_SCANNERS=true

# -----------------------------------------------------------------------------
# Scheduling
# -----------------------------------------------------------------------------
RESCAN_INTERVAL_HOURS=24
RESCAN_SWEEP_MINUTES=30
ALERT_SCORE_DELTA_THRESHOLD=10

# -----------------------------------------------------------------------------
# Storage (generated PDF reports)
# -----------------------------------------------------------------------------
REPORT_STORAGE_DIR=./storage/reports
MAX_LOGO_BYTES=524288

# -----------------------------------------------------------------------------
# Internal admin (comma-separated emails granted platform-admin access)
# -----------------------------------------------------------------------------
ZENTRA_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Frontend (apps/web) — NEXT_PUBLIC_* values are exposed to the browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_PROVIDER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
